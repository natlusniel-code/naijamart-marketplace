# Copy to .env.local — both values are public (browser-exposed) by design.
#
# These are OPTIONAL. `src/lib/supabase/config.ts` carries the same values as a
# literal fallback, so the app builds and runs correctly even when the host has
# no environment variables set. Setting them here (or in the Vercel dashboard)
# simply overrides the fallback.
#
# Why the fallback exists: Next.js inlines NEXT_PUBLIC_* at BUILD time. A host
# without these variables compiles `undefined` into the Edge middleware bundle,
# and `createServerClient(undefined, undefined)` throws on every request — which
# surfaces as a site-wide `500 MIDDLEWARE_INVOCATION_FAILED`.
NEXT_PUBLIC_SUPABASE_URL=https://ecejkevdfpzfvwfjjqwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nTmbEq4kh7viHqVFiSxtmw_m7Yh5-QI

# Public base URL of this app, used for OAuth + email verification redirects.
# Must match Supabase Auth → site_url / uri_allow_list, or confirmation links
# will bounce to the wrong origin. See README §1c.
NEXT_PUBLIC_SITE_URL=https://naijamart-marketplace-n.vercel.app

# Google sign-in is NOT enabled on the solo proud project, so the UI hides the
# Google button on its own (it reads GET /auth/v1/settings at runtime). No
# variable is needed here — enable the provider in the Supabase dashboard and
# the button reappears. See README §1c.

# Protects POST /api/jobs/run so the order timers can be driven by an external
# cron (Vercel Cron, GitHub Action, cron-job.org) without a service key.
# REQUIRED for that route — it returns 500 until this is set.
JOBS_SECRET=change-me

# NEVER add SUPABASE_SERVICE_ROLE_KEY here. The app is designed to run on the
# anon key + Row Level Security only.
